{
  "name": "dsh-plugin-auto-proxy",
  "version": "1.0.6",
  "description": "DSH 自动检测并连接本机 HTTP／混合代理，无需 TUN 或专用启动器。",
  "author": "murenyu1",
  "repository": { "type": "git", "url": "git+https://github.com/murenyu1/dsh-auto-proxy.git" },
  "homepage": "https://github.com/murenyu1/dsh-auto-proxy#readme",
  "bugs": { "url": "https://github.com/murenyu1/dsh-auto-proxy/issues" },
  "keywords": ["dsh-plugin", "deepseek-harness", "proxy"],
  "type": "module",
  "main": "index.mjs",
  "exports": { ".": "./index.mjs", "./client": "./client.js" },
  "files": ["index.mjs", "config.mjs", "client.js", "lib", "cordis.patch.yml", "README.md", "VALIDATION.md", "CHANGELOG.md", "RELEASING.md", "ACKNOWLEDGEMENTS.md"],
  "engines": { "node": ">=22.21", "dsh": "0.2.1-rc.2" },
  "peerDependencies": { "@deepseek-ai/dsh-http-proxy": "0.2.1-rc.2", "@deepseek-ai/schemastery": "^3.18.5" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-http-proxy": { "optional": true }, "@deepseek-ai/schemastery": { "optional": true } },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-plugin-manager"] }
  },
  "scripts": { "test": "node --test tests/*.test.mjs", "pack:plugin": "npm pack --ignore-scripts --pack-destination downloads" },
  "license": "MIT"
}
